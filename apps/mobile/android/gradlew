#!/usr/bin/env sh
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=${GRADLE_VERSION:-8.10.2}
GRADLE_HOME="$APP_HOME/.gradle/wrapper/dists/gradle-$GRADLE_VERSION"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"

if ! command -v java >/dev/null 2>&1; then
  echo "ERROR: Java runtime is required to run Gradle." >&2
  exit 1
fi

if [ ! -x "$GRADLE_BIN" ]; then
  ZIP_DIR="$APP_HOME/.gradle/wrapper/dists"
  ZIP_FILE="$ZIP_DIR/gradle-$GRADLE_VERSION-bin.zip"
  mkdir -p "$ZIP_DIR"
  if [ ! -f "$ZIP_FILE" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -L "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ZIP_FILE"
    else
      echo "ERROR: curl is required to download Gradle $GRADLE_VERSION." >&2
      exit 1
    fi
  fi
  unzip -q -o "$ZIP_FILE" -d "$ZIP_DIR"
fi

exec "$GRADLE_BIN" "$@"
