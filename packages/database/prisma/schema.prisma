generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppState {
  ONBOARDING
  TRIAL_READY
  TRIAL_LESSON
  TRIAL_RESULT
  SUBSCRIPTION
  HOME
  LESSON_SCHEDULED
  LESSON_READY
  LESSON_ACTIVE
  LESSON_FINISHING
  RESULT_GENERATING
  RESULT
  REVIEW
}

enum CefrLevel {
  A1
  A2
  B1
  B2
}

enum LessonOccurrenceStatus {
  SCHEDULED
  NOTIFICATION_PENDING
  NOTIFIED
  READY
  SNOOZED
  STARTING
  ACTIVE
  COMPLETED
  SKIPPED
  MISSED
  CANCELLED
  EXPIRED
  FAILED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  OPENED
  ACTIONED
  FAILED
  EXPIRED
}

enum NotificationType {
  LESSON_PRE_REMINDER
  LESSON_REMINDER
  LESSON_SNOOZE_REMINDER
  REPORT_READY
}

enum LessonStageType {
  CHECK_IN
  WARM_UP
  TARGET_PHRASES
  GUIDED_ROLEPLAY
  FREE_TALK
  CORRECTION
  WRAP_UP
  COMPLETED
}

enum ReviewItemStatus {
  NEW
  LEARNING
  REVIEWING
  MASTERED
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_MANAGER
  SUPPORT
  ANALYST
}

enum SubscriptionStatus {
  FREE
  TRIAL
  PREMIUM
  EXPIRED
}

enum LessonTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  displayName       String?
  appState          AppState           @default(ONBOARDING)
  timezone          String             @default("Asia/Seoul")
  locale            String             @default("ko-KR")
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  identities        UserIdentity[]
  refreshTokens     RefreshToken[]
  learnerProfile    LearnerProfile?
  devices           Device[]
  lessonSchedules   LessonSchedule[]
  lessonOccurrences LessonOccurrence[]
  lessonSessions    LessonSession[]
  userVocabulary    UserVocabulary[]
  reviewItems       ReviewItem[]
  progressSnapshots ProgressSnapshot[]
  subscriptions     Subscription[]
  entitlements      Entitlement[]

  @@index([appState])
  @@index([deletedAt])
}

model UserIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

model LearnerProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  level                CefrLevel
  englishVariant       String
  goals                String[]
  difficultAreas       String[]
  correctionPreference String
  interests            String[]
  dailyStudyMinutes    Int
  tutorId              String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutor                Tutor?   @relation(fields: [tutorId], references: [id], onDelete: SetNull)
}

model Tutor {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  personaKo       String
  personaEn       String
  imageUrl        String
  status          String           @default("ACTIVE")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  voices          TutorVoice[]
  profiles        LearnerProfile[]
  lessonSchedules LessonSchedule[]
  lessonOccurrences LessonOccurrence[]
  lessonSessions  LessonSession[]
  backchannelClips BackchannelClip[]
}

model TutorVoice {
  id          String   @id @default(uuid()) @db.Uuid
  tutorId     String   @db.Uuid
  provider    String
  providerKey String
  displayName String
  previewUrl  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tutor       Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
}

model BackchannelClip {
  id          String   @id @default(uuid()) @db.Uuid
  tutorId     String?  @db.Uuid
  clipKey     String
  label       String
  audioUrl    String
  weight      Int      @default(10)
  durationMs  Int
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tutor       Tutor?   @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  @@unique([tutorId, clipKey])
}

model Device {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  platform       String
  deviceName     String?
  appVersion     String?
  osVersion      String?
  deviceIdHash   String
  lastSeenAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushTokens     PushToken[]
  notificationDeliveries NotificationDelivery[]

  @@unique([userId, deviceIdHash])
}

model PushToken {
  id        String    @id @default(uuid()) @db.Uuid
  deviceId  String    @db.Uuid
  provider  String
  tokenHash String
  tokenValue String?
  tokenLast4 String
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  notificationDeliveries NotificationDelivery[]

  @@unique([provider, tokenHash])
  @@index([deviceId])
}

model LessonSchedule {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  tutorId            String             @db.Uuid
  timezone           String
  daysOfWeek         Int[]
  localTime          String
  durationMinutes    Int                @default(15)
  preReminderMinutes Int?
  enabled            Boolean            @default(true)
  nextRunAt          DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutor              Tutor              @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  occurrences        LessonOccurrence[]

  @@index([nextRunAt])
  @@index([userId, enabled])
}

model LessonOccurrence {
  id               String                 @id @default(uuid()) @db.Uuid
  scheduleId       String?                @db.Uuid
  userId           String                 @db.Uuid
  lessonTemplateId String                 @db.Uuid
  tutorId          String                 @db.Uuid
  scheduledAt      DateTime
  availableFrom    DateTime
  expiresAt        DateTime
  snoozeCount      Int                    @default(0)
  status           LessonOccurrenceStatus @default(SCHEDULED)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  version          Int                    @default(1)
  idempotencyKey   String?
  schedule         LessonSchedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonTemplate   LessonTemplate         @relation(fields: [lessonTemplateId], references: [id], onDelete: Restrict)
  tutor            Tutor                  @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  lessonSession    LessonSession?
  notifications    NotificationDelivery[]

  @@unique([idempotencyKey])
  @@index([scheduleId, scheduledAt])
  @@index([userId, status])
  @@index([scheduledAt, status])
}

model LessonTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  slug        String                  @unique
  titleKo     String
  titleEn     String
  level       CefrLevel
  category    String
  status      LessonTemplateStatus    @default(DRAFT)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  versions    LessonTemplateVersion[]
  occurrences LessonOccurrence[]
}

model LessonTemplateVersion {
  id                 String                @id @default(uuid()) @db.Uuid
  lessonTemplateId   String                @db.Uuid
  objective          String
  estimatedDuration  Int                   @default(900)
  version            Int
  status             LessonTemplateStatus  @default(DRAFT)
  promptVersionId    String?               @db.Uuid
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  lessonTemplate     LessonTemplate        @relation(fields: [lessonTemplateId], references: [id], onDelete: Cascade)
  stages             LessonStageTemplate[]
  materialCards      MaterialCard[]
  targetExpressions  TargetExpression[]
  promptVersion      PromptVersion?        @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  lessonSessions     LessonSession[]

  @@unique([lessonTemplateId, version])
}

model LessonStageTemplate {
  id                      String                @id @default(uuid()) @db.Uuid
  lessonTemplateVersionId String                @db.Uuid
  stageType               LessonStageType
  sequence                Int
  plannedDurationSeconds  Int
  objective               String
  entryCondition          String
  exitCondition           String
  promptInstruction       String
  backchannelEnabled      Boolean               @default(true)
  correctionPolicy        String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  lessonTemplateVersion   LessonTemplateVersion @relation(fields: [lessonTemplateVersionId], references: [id], onDelete: Cascade)

  @@unique([lessonTemplateVersionId, sequence])
}

model MaterialCard {
  id                      String                @id @default(uuid()) @db.Uuid
  lessonTemplateVersionId String                @db.Uuid
  type                    String
  title                   String
  body                    String
  imageUrl                String?
  audioUrl                String?
  targetExpressionIds     String[]
  hints                   String[]
  sequence                Int
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  lessonTemplateVersion   LessonTemplateVersion @relation(fields: [lessonTemplateVersionId], references: [id], onDelete: Cascade)

  @@index([lessonTemplateVersionId, sequence])
}

model TargetExpression {
  id                      String                @id @default(uuid()) @db.Uuid
  lessonTemplateVersionId String                @db.Uuid
  text                    String
  meaningKo               String
  examples                String[]
  alternatives            String[]
  level                   CefrLevel
  grammarTags             String[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  lessonTemplateVersion   LessonTemplateVersion @relation(fields: [lessonTemplateVersionId], references: [id], onDelete: Cascade)
  vocabularyItems         VocabularyItem[]

  @@index([lessonTemplateVersionId])
}

model LessonSession {
  id                      String                  @id @default(uuid()) @db.Uuid
  userId                  String                  @db.Uuid
  occurrenceId            String?                 @unique @db.Uuid
  tutorId                 String                  @db.Uuid
  lessonTemplateVersionId String?                 @db.Uuid
  state                   LessonStageType         @default(CHECK_IN)
  startedAt               DateTime?
  plannedEndAt            DateTime?
  actualEndAt             DateTime?
  timeScale               Float                   @default(1)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence              LessonOccurrence?       @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  tutor                   Tutor                   @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  lessonTemplateVersion   LessonTemplateVersion?  @relation(fields: [lessonTemplateVersionId], references: [id], onDelete: SetNull)
  stageSessions           LessonStageSession[]
  utterances              Utterance[]
  transcriptSegments      TranscriptSegment[]
  backchannelEvents       BackchannelEvent[]
  corrections             Correction[]
  vocabularyItems         VocabularyItem[]
  report                  LessonReport?

  @@index([userId, createdAt])
}

model LessonStageSession {
  id              String          @id @default(uuid()) @db.Uuid
  lessonSessionId String          @db.Uuid
  stageType       LessonStageType
  startedAt       DateTime
  plannedEndAt    DateTime
  actualEndAt     DateTime?
  objective       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lessonSession   LessonSession   @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)

  @@index([lessonSessionId, stageType])
}

model Utterance {
  id              String        @id @default(uuid()) @db.Uuid
  lessonSessionId String        @db.Uuid
  speaker         String
  transcript      String
  startedAt       DateTime
  endedAt         DateTime
  durationMs      Int
  createdAt       DateTime      @default(now())
  lessonSession   LessonSession @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)

  @@index([lessonSessionId, startedAt])
}

model TranscriptSegment {
  id              String        @id @default(uuid()) @db.Uuid
  lessonSessionId String        @db.Uuid
  speaker         String
  text            String
  isFinal         Boolean       @default(false)
  startedAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime      @default(now())
  lessonSession   LessonSession @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)

  @@index([lessonSessionId, createdAt])
}

model BackchannelEvent {
  id              String        @id @default(uuid()) @db.Uuid
  lessonSessionId String        @db.Uuid
  userTurnId      String?
  clipId          String
  trigger         String
  playedAt        DateTime
  durationMs      Int
  createdAt       DateTime      @default(now())
  lessonSession   LessonSession @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)

  @@index([lessonSessionId, playedAt])
}

model Correction {
  id                String          @id @default(uuid()) @db.Uuid
  lessonSessionId   String          @db.Uuid
  originalText      String
  correctedText     String
  explanationKo     String
  category          String
  severity          String
  stage             LessonStageType
  timestamp         DateTime
  repeatedCount     Int             @default(1)
  selectedForReport Boolean         @default(false)
  createdAt         DateTime        @default(now())
  lessonSession     LessonSession   @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)

  @@index([lessonSessionId, selectedForReport])
}

model VocabularyItem {
  id                 String            @id @default(uuid()) @db.Uuid
  lessonSessionId    String?           @db.Uuid
  targetExpressionId String?           @db.Uuid
  text               String
  meaningKo          String
  createdAt          DateTime          @default(now())
  lessonSession      LessonSession?    @relation(fields: [lessonSessionId], references: [id], onDelete: SetNull)
  targetExpression   TargetExpression? @relation(fields: [targetExpressionId], references: [id], onDelete: SetNull)
  userVocabulary     UserVocabulary[]

  @@unique([text, meaningKo])
}

model UserVocabulary {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  vocabularyItemId String         @db.Uuid
  savedAt          DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItem   VocabularyItem @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyItemId])
}

model ReviewItem {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @db.Uuid
  sourceType         String
  sourceId           String
  prompt             String
  answer             String
  status             ReviewItemStatus @default(NEW)
  nextReviewAt       DateTime
  intervalDays       Int              @default(1)
  easeFactor         Float            @default(2.5)
  consecutiveCorrect Int              @default(0)
  lastResult         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
}

model LessonReport {
  id                 String        @id @default(uuid()) @db.Uuid
  lessonSessionId    String        @unique @db.Uuid
  summary            String
  scores             Json
  userSpeakingRatio  Float
  reportJson         Json
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lessonSession      LessonSession @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)
}

model ProgressSnapshot {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  date                DateTime
  streakDays          Int
  completedLessons    Int
  totalSpeakingSeconds Int
  learnedExpressions  Int
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  provider           String
  providerCustomerId String?
  productId          String
  status             SubscriptionStatus
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Entitlement {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  state     SubscriptionStatus
  reason    String
  startsAt  DateTime
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
}

model NotificationDelivery {
  id                 String                     @id @default(uuid()) @db.Uuid
  occurrenceId       String                     @db.Uuid
  deviceId           String?                    @db.Uuid
  pushTokenId        String?                    @db.Uuid
  notificationType   NotificationType
  provider           String
  providerMessageId  String?
  status             NotificationDeliveryStatus @default(PENDING)
  scheduledFor       DateTime
  sentAt             DateTime?
  openedAt           DateTime?
  actionedAt         DateTime?
  failedAt           DateTime?
  failureCode        String?
  failureMessage     String?
  idempotencyKey     String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  occurrence         LessonOccurrence           @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  device             Device?                    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  pushToken          PushToken?                 @relation(fields: [pushTokenId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([occurrenceId, createdAt])
  @@index([status, scheduledFor])
}

model PromptTemplate {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  description String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  versions    PromptVersion[]
}

model PromptVersion {
  id                    String                  @id @default(uuid()) @db.Uuid
  promptTemplateId      String                  @db.Uuid
  version               Int
  body                  String
  isActive              Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  promptTemplate        PromptTemplate          @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  lessonTemplateVersions LessonTemplateVersion[]

  @@unique([promptTemplateId, version])
}

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  enabled     Boolean  @default(false)
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?
  actorRole   AdminRole?
  action      String
  targetType  String
  targetId    String?
  before      Json?
  after       Json?
  requestId   String
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  idempotencyKey String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  failedAt      DateTime?

  @@unique([idempotencyKey])
  @@index([processedAt, createdAt])
}
